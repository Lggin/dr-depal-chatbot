# Environment Variables

# Server
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# LLM
LLM_MODEL=Qwen/Qwen3.5-9B
LLM_QUANTIZATION=q4_k_m
LLM_MAX_TOKENS=1200
LLM_TEMPERATURE=0.2

# Embedding
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# Reranker
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Qdrant Vector DB
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=depalletizer_docs

# Database
DATABASE_URL=sqlite:///./data/chatbot.db

# Paths
CORPUS_PATH=./corpus
LOG_PATH=./logs

# Logging
LOG_LEVEL=INFO

# GPU
CUDA_VISIBLE_DEVICES=0
